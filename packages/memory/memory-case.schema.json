{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operad.io/schemas/memory-case.schema.json",
  "title": "operad memory regression case",
  "description": "One case of the memory regression set: an exchange where the bot got something wrong or the person corrected it. The file is named <id>.json.",
  "type": "object",
  "required": ["id", "kind", "question", "answer"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "kind": { "enum": ["miss", "correction"], "description": "A correction counts as a miss." },
    "context": {
      "type": "array",
      "description": "The messages before the question, oldest first.",
      "items": {
        "type": "object",
        "required": ["role", "text"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["user", "assistant"] },
          "text": { "type": "string" }
        }
      }
    },
    "question": { "type": "string", "minLength": 1 },
    "answer": {
      "type": "object",
      "required": ["facts"],
      "additionalProperties": false,
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Short phrases a right answer states. Matched ignoring case, spaces and punctuation."
        },
        "avoid": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Phrases of the wrong answer; an answer that states one fails."
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operad.io/schemas/triggers.schema.json",
  "title": "operad trigger rules",
  "description": "The rules in $OPERAD_HOME/triggers.json: which event starts which flow, and how far.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "source": {
        "type": "string",
        "minLength": 1,
        "description": "The source that sends the event, such as cron or operad."
      },
      "type": {
        "type": "string",
        "minLength": 1,
        "description": "The event type, such as tick or run.done."
      },
      "start": {
        "type": "object",
        "description": "The flow and fixed parameters to start.",
        "properties": {
          "flow": { "type": "string", "minLength": 1 },
          "params": {}
        },
        "required": ["flow"],
        "additionalProperties": false
      },
      "object": {
        "type": "string",
        "minLength": 1,
        "description": "A fixed object, or $event.object."
      },
      "mode": {
        "type": "string",
        "enum": ["observe", "candidate", "auto"]
      },
      "schedule": {
        "type": "string",
        "minLength": 1,
        "description": "A five-field cron expression in the local time zone."
      }
    },
    "required": ["source", "type", "start", "object", "mode"],
    "additionalProperties": false
  }
}

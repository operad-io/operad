{
  "$schema": "../packages/dev/dev.schema.json",
  "name": "operad",
  "concurrency": 3,
  "maxAutoRework": 4,
  "worker": {
    "use": "harness-claude/agent",
    "args": [
      "--model",
      "sonnet"
    ],
    "stallSecs": 900,
    "wallTimeSecs": 7200
  },
  "reviewer": {
    "use": "harness-radian/agent",
    "args": [
      "--provider",
      "chatgpt",
      "--model",
      "gpt-5.6-terra",
      "--thinking",
      "medium",
      "--approval",
      "auto"
    ],
    "fixLevel": "major",
    "timeoutSecs": 3600,
    "stallSecs": 900,
    "fallback": {
      "use": "harness-radian/agent",
      "args": [
        "--provider",
        "opencode-go",
        "--model",
        "deepseek-v4.1-flash",
        "--thinking",
        "medium",
        "--approval",
        "auto"
      ]
    }
  },
  "gate": {
    "commands": [
      "bash scripts/verify.sh"
    ]
  },
  "integration": {
    "keyCommands": [
      "bash scripts/verify.sh"
    ]
  }
}

{
  "$schema": "../packages/dev/dev.schema.json",
  "name": "operad",
  "concurrency": 4,
  "maxAutoRework": 4,
  "workers": {
    "claude": {
      "use": "harness-claude/agent",
      "args": [
        "--model",
        "sonnet"
      ],
      "count": 2,
      "stallSecs": 900,
      "wallTimeSecs": 7200
    },
    "pi": {
      "use": "harness-pi/agent",
      "args": [
        "--model",
        "opencode-go/deepseek-v4.1-flash"
      ],
      "stallSecs": 900,
      "wallTimeSecs": 7200,
      "fallback": "claude"
    },
    "radian": {
      "use": "harness-radian/agent",
      "args": [
        "--provider",
        "opencode-go",
        "--model",
        "deepseek-v4.1-flash"
      ],
      "stallSecs": 900,
      "wallTimeSecs": 7200,
      "fallback": "claude"
    }
  },
  "pools": {
    "default": [
      "claude",
      "pi",
      "radian"
    ]
  },
  "reviewer": {
    "use": "harness-pi/agent",
    "args": [
      "--model",
      "openai-codex/gpt-5.6-terra",
      "--thinking",
      "medium"
    ],
    "fixLevel": "major",
    "timeoutSecs": 3600,
    "stallSecs": 900,
    "fallback": {
      "use": "harness-claude/agent",
      "args": [
        "--model",
        "opus",
        "--effort",
        "medium"
      ]
    }
  },
  "prepare": [
    "bun install --frozen-lockfile"
  ],
  "gate": {
    "commands": [
      {
        "run": "if [ -f scripts/remote-check.sh ]; then bash scripts/remote-check.sh 'OPERAD_TEST_PARALLEL=$(( $(nproc 2>/dev/null || echo 4) / 2 )) bash scripts/check-changed.sh'; else bash scripts/verify.sh; fi",
        "failed": {
          "match": "^\\(fail\\) (.+?) \\[[0-9.]+m?s\\]$",
          "rerun": "bun test --timeout 30000 -t {pattern}"
        }
      }
    ],
    "commandTimeoutSecs": 2700
  },
  "integration": {
    "batch": 3,
    "keyCommands": [
      {
        "run": "bash scripts/remote-check.sh 'OPERAD_TEST_PARALLEL=$(( $(nproc 2>/dev/null || echo 4) / 2 )) bash scripts/verify.sh'",
        "failed": {
          "match": "^\\(fail\\) (.+?) \\[[0-9.]+m?s\\]$",
          "rerun": "bun test --timeout 30000 -t {pattern}"
        }
      }
    ]
  },
  "flows": {
    "default": {
      "stages": [
        {
          "stage": "work",
          "use": "harness-claude/agent",
          "args": [
            "--model",
            "sonnet"
          ]
        },
        {
          "stage": "check",
          "commands": [
            "bash scripts/verify.sh"
          ],
          "rerun": 1
        },
        {
          "stage": "review",
          "use": "harness-pi/agent",
          "args": [
            "--model",
            "openai-codex/gpt-5.6-terra",
            "--thinking",
            "medium"
          ],
          "later": [
            "--model",
            "opencode-go/deepseek-v4.1-flash"
          ]
        },
        {
          "stage": "human"
        }
      ]
    },
    "docs": {
      "stages": [
        {
          "stage": "work"
        },
        {
          "stage": "review"
        },
        {
          "stage": "human"
        }
      ]
    }
  }
}

{
  "name": "operad-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@operad-io/dev": "workspace:*",
    "@operad-io/shell": "workspace:*",
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@operad-io/engine": "workspace:*",
    "@operad-io/harness-pi": "workspace:*",
    "@operad-io/harness-radian": "workspace:*",
    "@operad-io/source-cron": "workspace:*",
    "@operad-io/harness-claude": "workspace:*",
    "@operad-io/pool": "workspace:*"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "npm:empty-npm-package@1.0.0"
  }
